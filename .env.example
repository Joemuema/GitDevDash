# GitHub API token (https://github.com/settings/tokens)
# Optional but recommended to avoid rate limits (60 req/hr unauthenticated vs 5000 req/hr authenticated)
# Copy this file to .env.local and paste your own token — never commit real values.
GITHUB_TOKEN=ghp_replace_with_your_own_token

# Google OAuth (optional) — enables the "Continue with Google" button.
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# and add the redirect URI below to its "Authorised redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Session signing secret (required in production) — signs the encrypted session
# cookie that keeps you signed in. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Where account records are stored (optional) — defaults to ./.data/users.json
# AUTH_STORE_PATH=
